# Arguments to be overridden by downstream forks.
declare_args() {
  rebel_browser_name = "Rebel"
  rebel_browser_name_path_component = "rebel"

  rebel_browser_company = "Viasat Inc."
  rebel_browser_company_path_component = "Viasat"

  rebel_browser_schema = "rebel"

  rebel_package = "com.viasat.rebel"

  rebel_new_tab_page_url = "https://browser.viasat.com/rebel_ntp/index.html"
}

# Arguments to help with Chromium integration (i.e. not to be overridden).
declare_args() {
  is_rebel_based = true
  rebel_browser_branding_directory = "//rebel/branding/$rebel_browser_name_path_component"
}
